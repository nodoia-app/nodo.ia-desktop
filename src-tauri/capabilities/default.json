{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Default Nodo desktop capabilities",
  "windows": ["main"],
  "remote": {
    "urls": [
      "https://login.nodoia.app/*",
      "https://www.nodoia.app/*",
      "https://nodoia.app/*",
      "http://localhost:3000/*",
      "http://localhost:3002/*",
      "http://127.0.0.1:3000/*",
      "http://10.0.0.40:3000/*",
      "http://10.0.0.40:3002/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:default",
    "core:webview:default",
    "opener:default",
    "allow-scan-lan-printers",
    "allow-confirm-lan-printer",
    "allow-print-lan"
  ]
}
