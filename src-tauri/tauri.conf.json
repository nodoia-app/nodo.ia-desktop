{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nodo",
  "version": "1.0.0",
  "identifier": "app.nodoia.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000/agent"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Nodo",
    "longDescription": "Nodo — agente y POS para tu negocio.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
